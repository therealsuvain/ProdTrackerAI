+/**
+ * Calculate the maximum physical-pixel dimensions an asset reaches during
+ * Act 3. expo-image applies these limits during decode, not as a visual crop.
+ * Dimensions are capped at the source, so this never upscales or discards
+ * source detail that the on-screen animation can actually display.
+ */
+function getAct3ImageLoadOptions(
+  frame: Act3FrameDimensions,
+  targetVisibleWidthDp: number,
+  maximumVisualScale: number,
+) {
+  const alphaWidth = Math.max(1, frame.alphaRight - frame.alphaLeft);
+  const sourceToDp = targetVisibleWidthDp / alphaWidth;
+  const physicalPixelScale =
+    sourceToDp *
+    maximumVisualScale *
+    PixelRatio.get() *
+    ACT3_IMAGE_DECODE_OVERSAMPLE;
+
+  return {
+    maxWidth: Math.max(
+      1,
+      Math.min(frame.sourceWidth, Math.ceil(frame.sourceWidth * physicalPixelScale)),
+    ),
+    maxHeight: Math.max(
+      1,
+      Math.min(frame.sourceHeight, Math.ceil(frame.sourceHeight * physicalPixelScale)),
+    ),
+  };
+}
